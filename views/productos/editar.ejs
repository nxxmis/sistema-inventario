<!DOCTYPE html>
<html>
<head>
    <title>Editar Objeto</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container">
    <h1 style="color: #31a2d1; border-bottom: 2px solid #31a2d1; padding-bottom: 10px;">✏️ Editar: <%= producto.nombre %></h1>
    
    <form action="/productos/<%= producto.id %>?_method=PUT" method="POST" style="margin-top: 20px;">
        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Nombre:</label>
            <input type="text" name="nombre" value="<%= producto.nombre %>" required style="width:100%; padding:8px;">
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Descripción:</label>
            <textarea name="descripcion" rows="3" style="width:100%; padding:8px;"><%= producto.descripcion %></textarea>
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Ubicación (Estante):</label>
            <select name="estante_id" required style="width:100%; padding:8px;">
                <% estantes.forEach(e => { %>
                    <option value="<%= e.id %>" <%= producto.estante_id && producto.estante_id.toString() === e.id.toString() ? 'selected' : '' %>>
                        <%= e.nombre_bodega %> > <%= e.nombre_sector %> > <%= e.nombre %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Stock Actual:</label>
            <input type="number" min="0" name="cantidad_actual" value="<%= producto.cantidad_actual %>" style="width:100%; padding:8px;">
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Precio ($):</label>
            <input type="number" step="0.01" name="precio" value="<%= producto.precio %>" style="width:100%; padding:8px;">
        </div>

        <div style="display: flex; justify-content: space-between; margin-top: 30px;">
            <a href="/productos" style="color: #999; text-decoration: none;">Volver</a>
            <button type="submit" style="background-color: #31a2d1; color: white; padding: 10px 25px; border: none; border-radius: 4px; cursor: pointer;">Actualizar Cambios</button>
        </div>
    </form>
</div>
</body>
</html>