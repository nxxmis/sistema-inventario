<!DOCTYPE html>
<html>
<head>
    <title>Nuevo Objeto</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container">
    <h1 style="color: #31a2d1; border-bottom: 2px solid #31a2d1; padding-bottom: 10px;">📦 Nuevo Objeto</h1>
    
    <form action="/productos" method="POST" style="margin-top: 20px;">
        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Nombre del Objeto:</label>
            <input type="text" name="nombre" placeholder="Ej: Engrapadora Industrial" required style="width:100%; padding:8px;">
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Descripción:</label>
            <textarea name="descripcion" rows="3" style="width:100%; padding:8px;"></textarea>
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Ubicación (Estante):</label>
            <select name="estante_id" required style="width:100%; padding:8px;">
                <% estantes.forEach(e => { %>
                    <option value="<%= e.id %>"><%= e.nombre_bodega %> > <%= e.nombre_sector %> > <%= e.nombre %></option>
                <% }) %>
            </select>
        </div>

        <div style="display: flex; gap: 20px; margin-bottom: 15px;">
            <div style="flex: 1;">
                <label style="display:block; font-weight:bold;">Cantidad Inicial:</label>
                <input type="number" min="0" name="cantidad_inicial" value="0" style="width:100%; padding:8px;">
            </div>
            <div style="flex: 1;">
                <label style="display:block; font-weight:bold;">Precio Unitario ($):</label>
                <input type="number" step="0.01" name="precio" value="0.00" style="width:100%; padding:8px;">
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 30px;">
            <a href="/productos" style="color: #999; text-decoration: none;">← Cancelar</a>
            <button type="submit" style="background-color: #27ae60; color: white; padding: 10px 25px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Guardar Objeto</button>
        </div>
    </form>
</div>
</body>
</html>